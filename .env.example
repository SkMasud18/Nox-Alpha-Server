# Nox Alpha Server Environment Template
# Copy this file to .env and configure your secrets

PORT=8000
ENVIRONMENT=production

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/nox_db
REDIS_URL=redis://localhost:6379/0

# Sovereign Neural Mesh & Brain Cluster
NOX_NEURAL_BACKBONE_KEY=your_nox_neural_backbone_key_here
PRIMARY_ROUTER_MODEL=nox-alpha-deepseek-r1-7b

# Whisper Audio STT Hardware Config
WHISPER_MODEL_NAME=turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
